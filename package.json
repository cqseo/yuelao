{
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "name": "yuelao",
  "packageManager": "pnpm@10.30.1",
  "private": true,
  "scripts": {
    "check": "pnpm --filter @yuelao/core check && pnpm --filter ./sites/yuelao check",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test:local:payments": "bash tools/run-local-payment-e2e.sh",
    "test:ai:chat": "tsx tools/test-ai-chat.ts",
    "test:ai:quota": "bash tools/run-ai-chat-quota.sh",
    "test:db:retrofit": "bash tools/test-db-retrofit.sh",
    "test:auth:otp": "tsx tools/test-auth-otp.ts",
    "test:stripe:webhook": "tsx tools/test-stripe-webhook.ts",
    "test:wishes": "tsx tools/test-wishes.ts",
    "test:wishes:db": "bash tools/run-wishing-pool.sh",
    "test:profiles:db": "bash tools/run-profiles-on-signup.sh",
    "test:checkout": "tsx tools/test-checkout-failure.ts",
    "test:plaza": "tsx tools/test-plaza.ts",
    "test:spread:db": "bash tools/run-spread-readings.sh",
    "test:spread": "tsx tools/test-spread.ts",
    "test:daily:db": "bash tools/run-daily-checkins.sh",
    "test:daily": "tsx tools/test-daily-checkin.ts",
    "test:hall:db": "bash tools/run-hall-offerings.sh",
    "test:hall": "tsx tools/test-hall-offering.ts",
    "test:billing:mode": "tsx tools/test-billing-mode.ts",
    "i18n:check": "node tools/i18n-extract.mjs"
  },
  "type": "module"
}
