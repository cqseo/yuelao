{
  "$schema": "node_modules/wrangler/config-schema.json",
  // No D1 / R2 / Email / Workflows: the data layer is Supabase (see docs/architecture.md).
  "name": "yuelao",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // 大殿同拜：一間殿一個 Durable Object（只同步位置與動作，不存資料）。
  // 廣場同遊：一個廣場分身一個 Durable Object（同樣只同步位置、姿勢與動作）。
  "durable_objects": {
    "bindings": [
      { "name": "HALL", "class_name": "HallRoom" },
      { "name": "PLAZA", "class_name": "PlazaRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1-hall", "new_sqlite_classes": ["HallRoom"] },
    { "tag": "v2-plaza", "new_sqlite_classes": ["PlazaRoom"] }
  ],
  // Staging creates a separate Worker, with no live DB, API keys or payment secrets.
  "env": {
    "staging": {
      "name": "yuelao-v2-staging-20261109",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "HALL", "class_name": "HallRoom" },
          { "name": "PLAZA", "class_name": "PlazaRoom" }
        ]
      },
      "vars": {
        "SITE_STAGING": "true",
        "APP_URL": "https://yuelao-v2-staging-20261109.cqseo.workers.dev",
        "EMAIL_FROM": "noreply@example.invalid",
        "SUPABASE_URL": "",
        "SUPABASE_ANON_KEY": "",
        "BILLING_ENABLE_TEST_CHECKOUT": "false",
        "AI_ENABLE_TEST_GENERATION": "false",
        "AI_CHAT_ENABLED": "false",
        "WISHES_ENABLED": "false",
        "WISH_AUTO_MODERATION": "false",
        "RYBBIT_UPSTREAM": ""
      }
    }
  },
  "vars": {
    "EMAIL_FROM": "noreply@example.com",
    // 正式 Supabase 專案 yuelao。anon key 是公開金鑰（RLS 照常生效）；service_role 只放 wrangler secret。
    "SUPABASE_URL": "https://ichsqdfrwymlizqgxnqw.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImljaHNxZGZyd3ltbGl6cWd4bnF3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM4ODMyNjYsImV4cCI6MjEwOTQ1OTI2Nn0.nmuGBobYejLEzjlODojRBLngScHbTI1iYlyHiAVQRGA",
    // Test-only Stripe Checkout; NEVER enable with live keys. 程式也會拒絕正式金鑰（sk_live）。
    "BILLING_ENABLE_TEST_CHECKOUT": "true",
    // 測試卡號是公開的，測試結帳只開給這些信箱（逗號分隔）；其他人看到「尚未開放」。
    "BILLING_TEST_ALLOWED_EMAILS": "1054935976@qq.com",
    "AI_ENABLE_TEST_GENERATION": "true",
    // 付費深度解讀走 OpenAI 相容中轉站（chat/completions）；金鑰 OPENAI_API_KEY 只放 wrangler secret。
    "OPENAI_BASE_URL": "https://api.sqface.sbs/v1",
    "OPENAI_MODEL": "deepseek-v4.1-flash",
    "AI_CHAT_ENABLED": "false",
    // 許願池：使用者寫的字公開可見。wishing_pool 遷移已於 2026-11-12 套用到 Supabase。
    "WISHES_ENABLED": "true",
    // "true" 才把願望送 OpenAI moderation 自動放行；否則一律待審，人工用 review_wish 放行。
    "WISH_AUTO_MODERATION": "false",
    // To enable Rybbit, set this to your Rybbit API URL and add analytics.rybbit to site.config.ts.
    "RYBBIT_UPSTREAM": ""
  }
}
