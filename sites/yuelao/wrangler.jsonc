{
  "$schema": "node_modules/wrangler/config-schema.json",
  // No D1 / R2 / Email / Workflows: the data layer is Supabase (see docs/architecture.md).
  "name": "yuelao",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Staging creates a separate Worker, with no live DB, API keys or payment secrets.
  "env": {
    "staging": {
      "name": "yuelao-v2-staging-20261109",
      "workers_dev": true,
      "vars": {
        "SITE_STAGING": "true",
        "APP_URL": "https://yuelao-v2-staging-20261109.cqseo.workers.dev",
        "EMAIL_FROM": "noreply@example.invalid",
        "SUPABASE_URL": "",
        "SUPABASE_ANON_KEY": "",
        "BILLING_ENABLE_TEST_CHECKOUT": "false",
        "AI_ENABLE_TEST_GENERATION": "false",
        "AI_CHAT_ENABLED": "false",
        "RYBBIT_UPSTREAM": ""
      }
    }
  },
  "vars": {
    "EMAIL_FROM": "noreply@example.com",
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": "",
    // Test-only Stripe Checkout; NEVER enable with live keys.
    "BILLING_ENABLE_TEST_CHECKOUT": "false",
    "AI_ENABLE_TEST_GENERATION": "false",
    "AI_CHAT_ENABLED": "false",
    // To enable Rybbit, set this to your Rybbit API URL and add analytics.rybbit to site.config.ts.
    "RYBBIT_UPSTREAM": ""
  }
}
