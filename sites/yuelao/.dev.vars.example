# Copy to sites/yuelao/.dev.vars (never commit real values).
# Supabase: Dashboard → Settings → API. The service_role key is secret: only here
# and in `wrangler secret`, never in the repo or in chat.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:5173
EMAIL_FROM=noreply@example.com
# Payments: test keys locally; run node ../../tools/stripe-listen.mjs in the site dir
# to forward webhooks, and it writes whsec back to .dev.vars.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
