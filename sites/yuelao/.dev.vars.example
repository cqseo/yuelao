# Copy to sites/yuelao/.dev.vars (never commit real values).
# Supabase: Dashboard → Settings → API. The service_role key is secret: only here
# and in `wrangler secret`, never in the repo or in chat.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:5173
EMAIL_FROM=noreply@example.com
# Payments: test keys locally; run node ../../tools/stripe-listen.mjs in the site dir
# to forward webhooks, and it writes whsec back to .dev.vars.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Test checkout requires Supabase + sk_test_* + verified JWT + webhook signing.
# Keep false unless manually running the Stripe sandbox.
BILLING_ENABLE_TEST_CHECKOUT=false
# Optional AI reading pipeline: test-only until report fulfillment, refunds and
# privacy rules are verified. Keep OFF on production.
AI_ENABLE_TEST_GENERATION=false
OPENAI_API_KEY=
OPENAI_MODEL=
